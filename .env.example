# ==========================================
# EVENTORA Deployment Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL / Neon.tech)
# Example: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/eventora_db?sslmode=require"

# JWT Authentication (generate a secure random 32+ character string)
JWT_SECRET="your_secure_random_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Client URL for CORS (set to your deployed frontend domain)
CLIENT_URL="https://event-passing-qr.vercel.app"

# Optional Frontend Environment Variable (configured in Vercel Project Settings)
# VITE_API_URL="https://your-render-app-name.onrender.com/api"

# Optional Email SMTP (for production ticket delivery)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EVENTORA <tickets@eventora.io>"
