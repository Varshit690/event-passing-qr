# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# SQLite (default for zero-setup local dev): file:./dev.db
# PostgreSQL (production / optional): postgresql://postgres:postgres@localhost:5432/eventora?schema=public
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="eventora_super_secret_jwt_key_2026_unbreakable_production_grade"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Optional Email SMTP (for production tickets)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EVENTORA <tickets@eventora.io>"
