# ==========================================
# EVENTORA Server Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas / Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/eventora?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/eventora
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventora?retryWrites=true&w=majority"

# JWT Authentication (generate a secure random 32+ character string)
JWT_SECRET="your_secure_random_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# CORS Allowed Client Domain (set to your Vercel deployment URL)
CLIENT_URL="https://event-passing-qr.vercel.app"
